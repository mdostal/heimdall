# Heimdall credentials.
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
#
# Lanes are declared as contiguous HEIMDALL_LANE_<N>_* triples, starting at 1.
# credential_ref names a secret source, not the secret itself. By default it
# names another env var (the original REQ-07 local stopgap). To use Portunus,
# set HEIMDALL_SECRET_BROKER=portunus and use credential_ref=portunus:<ref>.

HEIMDALL_LANE_1_ID=claude@mathew.dostal
HEIMDALL_LANE_1_PROVIDER=claude
HEIMDALL_LANE_1_MODEL=claude-sonnet
HEIMDALL_LANE_1_CREDENTIAL_REF=CLAUDE_MATHEW_DOSTAL_TOKEN
CLAUDE_MATHEW_DOSTAL_TOKEN=

HEIMDALL_LANE_2_ID=codex
HEIMDALL_LANE_2_PROVIDER=codex
HEIMDALL_LANE_2_MODEL=gpt-codex
HEIMDALL_LANE_2_CREDENTIAL_REF=CODEX_TOKEN
CODEX_TOKEN=

# Optional: Portunus brokered secret refs. The Portunus CLI owns policy,
# approval, audit, and vault access; Heimdall stores only the reference name.
# Scope is metadata for the brokered lane contract; Portunus' current CLI
# resolves by reference name, whose registry entry carries its true scope.
#
# HEIMDALL_SECRET_BROKER=portunus
# HEIMDALL_LANE_1_CREDENTIAL_REF=portunus:shared-anthropic
# HEIMDALL_LANE_1_CREDENTIAL_SCOPE=shared
# PORTUNUS_BIN=portunus
#
# Local stopgap when Portunus is absent for the same brokered ref:
# HEIMDALL_LOCAL_SECRET_SHARED_ANTHROPIC=

# Optional: override the SQLite state-store path (default: in-memory).
# HEIMDALL_DB_PATH=./heimdall-state.sqlite

# Optional: override the HTTP server port (default: 4870).
# PORT=4870

# Required for MulticaAutopilotScheduler (hdl-03): the Multica assignee agent
# dispatched when a lane's coarse cron autopilot fires. Any existing agent
# identifier in your Multica workspace works (e.g. a generic dev agent) —
# Heimdall does not provision the agent itself, only registers the autopilot.
MULTICA_AUTOPILOT_AGENT=dostal-dev

# Optional: Argus OTEL endpoint overrides (defaults: 100.75.161.82, gRPC 4327 / HTTP 4328).
# ARGUS_OTLP_PROTOCOL=grpc
# ARGUS_OTLP_HOST=100.75.161.82
# ARGUS_OTLP_GRPC_PORT=4327
# ARGUS_OTLP_HTTP_PORT=4328

# Required for MulticaControlAdapter (hdl-actuation): the REST API this
# process actually calls. Multica does NOT run on this laptop — it runs on
# a separate machine ("the hive") at :8090. NO safe default exists (either
# value would be actively wrong depending on where Heimdall is deployed):
#   co-located on the hive (prod):  http://localhost:8090
#   remote/dev (Tailscale):         http://100.75.161.82:8090
MULTICA_BASE_URL=http://100.75.161.82:8090

# Required: every /api/agents and /api/runtimes call must be workspace-scoped
# or Multica 400s with {"error":"workspace_id or workspace_slug is required"}.
MULTICA_WORKSPACE_ID=d70dc5cf

# Required: the Multica Bearer PAT, resolved via the same CredentialSource
# abstraction lane credentials use. To broker it through Portunus, set:
# MULTICA_PAT_TOKEN_REF=portunus:multica-pat
MULTICA_PAT_TOKEN=

# Optional: per-lane Multica agent ID mapping (comma-separated) — lanes
# without this get a StubControlAdapter (log-only) instead of real actuation.
# HEIMDALL_LANE_1_MULTICA_AGENT_IDS=agent-id-a,agent-id-b
