{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heimdall",
  "version": "0.26.0",
  "identifier": "com.mdostal.heimdall",
  "build": {
    "frontendDist": "../dist-placeholder",
    "beforeBuildCommand": "bash src-tauri/build-resources.sh"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/heimdall": "heimdall",
      "resources/relauncher.sh": "relauncher.sh"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
