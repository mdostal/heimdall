{
  "name": "heimdall",
  "version": "0.16.0",
  "private": true,
  "description": "Pantheon's health-aware LLM/lane router — v1 sense (lane health/status) + v2 actuate (Multica control).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --experimental-sqlite --env-file-if-exists=.env --import tsx src/main.ts",
    "dev:http-only": "node --experimental-sqlite --env-file-if-exists=.env --import tsx src/api/http-server.ts",
    "cli": "node --experimental-sqlite --env-file-if-exists=.env --import tsx src/api/cli.ts",
    "mcp": "node --experimental-sqlite --env-file-if-exists=.env --import tsx src/api/mcp-server.ts",
    "test": "node --experimental-sqlite --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "sla-report": "node --experimental-sqlite --import tsx test/sla-harness/index.ts",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  }
}
