{
  "name": "heimdall",
  "version": "0.1.0",
  "private": true,
  "description": "Pantheon's health-aware LLM/lane router — v1 (P0): lane health/status detection.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx src/api/http-server.ts",
    "cli": "node --experimental-sqlite --import tsx src/api/cli.ts",
    "mcp": "node --experimental-sqlite --import tsx src/api/mcp-server.ts",
    "test": "node --experimental-sqlite --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "sla-report": "node --experimental-sqlite --import tsx test/sla-harness/index.ts",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
