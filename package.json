{
  "name": "pantheon-heimdall",
  "version": "0.33.1",
  "description": "Pantheon's health-aware LLM/lane router \u2014 v1 sense (lane health/status) + v2 actuate (Multica control).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdostal/heimdall.git"
  },
  "homepage": "https://github.com/mdostal/heimdall#readme",
  "bugs": {
    "url": "https://github.com/mdostal/heimdall/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "heimdall": "bin/heimdall.js"
  },
  "files": [
    "dist",
    "bin",
    "agent_skills"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "dev:http-only": "node --env-file-if-exists=.env --import tsx src/api/http-server.ts",
    "cli": "node --env-file-if-exists=.env --import tsx src/api/cli.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/api/mcp-server.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\" \"hive/**/*.test.ts\"",
    "sla-report": "node --import tsx test/sla-harness/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "marked": "^18.0.9",
    "mermaid": "^11.16.1",
    "yaml": "^2.9.0"
  }
}
